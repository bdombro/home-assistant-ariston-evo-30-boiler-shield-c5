# Copy to .env (gitignored) and fill in. Variables already exported in your shell take precedence.
# All are required; the justfile has no fallbacks.
HA_URL=http://homeassistant.local:8123   # or http://<ip>[:port]; this repo's HA listens on port 80
HA_SSH=ha                                # ssh host alias for Home Assistant (Terminal & SSH app)
EBUSD_APP=b4d7ad18_ebusd                 # eBUSd app slug (b4d7ad18 = the LukasGrebe/ha-addons repo hash)
HA_TOKEN=                                # long-lived access token; or export it from your shell profile
